CREATE TABLE BaseFood (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    carbsPer100g REAL NOT NULL,
    remoteKey TEXT UNIQUE,
    source TEXT NOT NULL DEFAULT 'default',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    needsSync INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isPacked INTEGER NOT NULL DEFAULT 0,
    packWeight REAL,
    packCount INTEGER
);

CREATE TABLE Dish (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    remoteKey TEXT UNIQUE,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    needsSync INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    totalCookedWeight REAL
);

CREATE TABLE DishComponent (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    dishId INTEGER NOT NULL,
    baseFoodId INTEGER NOT NULL,
    percentage REAL NOT NULL DEFAULT 0,
    weightGrams REAL NOT NULL DEFAULT 0,
    FOREIGN KEY (dishId) REFERENCES Dish(id),
    FOREIGN KEY (baseFoodId) REFERENCES BaseFood(id)
);

CREATE TABLE MealType (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    targetCarbs REAL NOT NULL,
    hourOfDay INTEGER NOT NULL,
    remoteKey TEXT,
    scope TEXT NOT NULL DEFAULT 'family',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    needsSync INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE Setting (
    key TEXT PRIMARY KEY,
    content TEXT,
    needsSync INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE FamilyMember (
    email TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL DEFAULT '',
    firebaseUid TEXT,
    isOwner INTEGER NOT NULL DEFAULT 0,
    addedAt INTEGER NOT NULL DEFAULT 0
);

-- Queries
insertBaseFood:
INSERT INTO BaseFood(name, carbsPer100g, remoteKey, source, isDeleted, needsSync, updatedAt, isPacked, packWeight, packCount)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateBaseFood:
UPDATE BaseFood SET name = ?, carbsPer100g = ?, isPacked = ?, packWeight = ?, packCount = ?, needsSync = ?, updatedAt = ? WHERE id = ?;

deleteBaseFood:
UPDATE BaseFood SET isDeleted = 1, needsSync = ?, updatedAt = ? WHERE id = ?;

restoreBaseFood:
UPDATE BaseFood SET isDeleted = 0, needsSync = ?, updatedAt = ? WHERE id = ?;

deleteBaseFoodPermanently:
DELETE FROM BaseFood WHERE id = ?;

selectAllBaseFoods:
SELECT * FROM BaseFood WHERE isDeleted = 0 ORDER BY name;

selectAllBaseFoodsIncludingDeleted:
SELECT * FROM BaseFood ORDER BY id;

selectBaseFoodById:
SELECT * FROM BaseFood WHERE id = ?;

selectBaseFoodByRemoteKey:
SELECT * FROM BaseFood WHERE remoteKey = ?;

selectBaseFoodsNeedingSync:
SELECT * FROM BaseFood WHERE needsSync = 1 ORDER BY updatedAt, id;

markBaseFoodSynced:
UPDATE BaseFood SET needsSync = 0 WHERE id = ?;

markAllBaseFoodsForSync:
UPDATE BaseFood SET needsSync = 1, updatedAt = ?;

updateBaseFoodSyncMetadata:
UPDATE BaseFood
SET remoteKey = ?, source = ?, needsSync = ?, updatedAt = ?
WHERE id = ?;

applyRemoteBaseFood:
UPDATE BaseFood
SET name = ?, carbsPer100g = ?, isPacked = ?, packWeight = ?, packCount = ?, isDeleted = ?, needsSync = 0, updatedAt = ?
WHERE id = ?;

insertDish:
INSERT INTO Dish(name, remoteKey, isDeleted, needsSync, updatedAt, totalCookedWeight) VALUES (?, ?, ?, ?, ?, ?);

updateDish:
UPDATE Dish SET name = ?, totalCookedWeight = ?, needsSync = ?, updatedAt = ? WHERE id = ?;

deleteDish:
UPDATE Dish SET isDeleted = 1, needsSync = ?, updatedAt = ? WHERE id = ?;

restoreDish:
UPDATE Dish SET isDeleted = 0, needsSync = ?, updatedAt = ? WHERE id = ?;

deleteDishPermanently:
DELETE FROM Dish WHERE id = ?;

selectAllDishes:
SELECT * FROM Dish WHERE isDeleted = 0 ORDER BY name;

selectAllDishesIncludingDeleted:
SELECT * FROM Dish ORDER BY id;

selectDishById:
SELECT * FROM Dish WHERE id = ?;

selectDishByRemoteKey:
SELECT * FROM Dish WHERE remoteKey = ?;

selectDishesNeedingSync:
SELECT * FROM Dish WHERE needsSync = 1 ORDER BY updatedAt, id;

markDishSynced:
UPDATE Dish SET needsSync = 0 WHERE id = ?;

markAllDishesForSync:
UPDATE Dish SET needsSync = 1, updatedAt = ?;

updateDishSyncMetadata:
UPDATE Dish SET remoteKey = ?, needsSync = ?, updatedAt = ? WHERE id = ?;

applyRemoteDish:
UPDATE Dish SET name = ?, totalCookedWeight = ?, isDeleted = ?, needsSync = 0, updatedAt = ? WHERE id = ?;

insertDishComponent:
INSERT INTO DishComponent(dishId, baseFoodId, percentage, weightGrams) VALUES (?, ?, 0, ?);

deleteComponentsByDishId:
DELETE FROM DishComponent WHERE dishId = ?;

lastInsertRowId:
SELECT last_insert_rowid();

selectComponentsByDishId:
SELECT 
    DishComponent.*, 
    BaseFood.name AS foodName, 
    BaseFood.carbsPer100g AS foodCarbs 
FROM DishComponent 
JOIN BaseFood ON DishComponent.baseFoodId = BaseFood.id 
WHERE dishId = ?;

insertMealType:
INSERT INTO MealType(name, targetCarbs, hourOfDay, remoteKey, scope, isDeleted, needsSync, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateMealType:
UPDATE MealType SET name = ?, targetCarbs = ?, hourOfDay = ?, needsSync = ?, updatedAt = ? WHERE id = ?;

deleteMealType:
UPDATE MealType SET isDeleted = 1, needsSync = ?, updatedAt = ? WHERE id = ?;

selectAllMealTypes:
SELECT * FROM MealType WHERE scope = ? AND isDeleted = 0 ORDER BY hourOfDay, name;

selectAllMealTypesIncludingDeleted:
SELECT * FROM MealType WHERE scope = ? ORDER BY id;

selectMealTypeByRemoteKey:
SELECT * FROM MealType WHERE remoteKey = ? AND scope = ?;

selectMealTypesNeedingSync:
SELECT * FROM MealType WHERE scope = 'family' AND needsSync = 1 ORDER BY updatedAt, id;

markMealTypeSynced:
UPDATE MealType SET needsSync = 0 WHERE id = ?;

markFamilyMealTypesForSync:
UPDATE MealType SET needsSync = 1, updatedAt = ? WHERE scope = 'family';

updateMealTypeSyncMetadata:
UPDATE MealType SET remoteKey = ?, scope = ?, needsSync = ?, updatedAt = ? WHERE id = ?;

applyRemoteMealType:
UPDATE MealType SET name = ?, targetCarbs = ?, hourOfDay = ?, isDeleted = ?, needsSync = 0, updatedAt = ? WHERE id = ?;

deleteMealTypesByScope:
DELETE FROM MealType WHERE scope = ?;

getLanguage:
SELECT content FROM Setting WHERE key = 'language';

setLanguage:
INSERT OR REPLACE INTO Setting(key, content, needsSync, updatedAt) VALUES ('language', ?, ?, ?);

getFoodLanguage:
SELECT content FROM Setting WHERE key = 'food_language';

setFoodLanguage:
INSERT OR REPLACE INTO Setting(key, content, needsSync, updatedAt) VALUES ('food_language', ?, ?, ?);

selectSettingsNeedingSync:
SELECT * FROM Setting WHERE key IN ('language', 'food_language') AND needsSync = 1 ORDER BY updatedAt, key;

selectSettingByKey:
SELECT * FROM Setting WHERE key = ?;

markSettingSynced:
UPDATE Setting SET needsSync = 0 WHERE key = ?;

markSyncableSettingsForSync:
UPDATE Setting SET needsSync = 1, updatedAt = ? WHERE key IN ('language', 'food_language');

applyRemoteSetting:
INSERT OR REPLACE INTO Setting(key, content, needsSync, updatedAt) VALUES (?, ?, 0, ?);

insertFamilyMember:
INSERT OR IGNORE INTO FamilyMember(email, name, firebaseUid, isOwner, addedAt) VALUES (?, ?, ?, ?, ?);

deleteFamilyMemberByEmail:
DELETE FROM FamilyMember WHERE email = ?;

deleteFamilyMemberByFirebaseUid:
DELETE FROM FamilyMember WHERE firebaseUid = ?;

selectAllFamilyMembers:
SELECT * FROM FamilyMember ORDER BY addedAt;

selectFamilyMemberByEmail:
SELECT * FROM FamilyMember WHERE email = ?;

selectFamilyMemberByFirebaseUid:
SELECT * FROM FamilyMember WHERE firebaseUid = ?;

updateFamilyMemberFirebaseUid:
UPDATE FamilyMember SET firebaseUid = ? WHERE email = ?;

updateFamilyMemberName:
UPDATE FamilyMember SET name = ? WHERE email = ?;

getFamilyOwnerUid:
SELECT firebaseUid FROM FamilyMember WHERE isOwner = 1 AND firebaseUid IS NOT NULL LIMIT 1;

clearOwner:
UPDATE FamilyMember SET isOwner = 0;

setOwner:
UPDATE FamilyMember SET isOwner = 1 WHERE email = ?;

countFamilyMembers:
SELECT COUNT(*) FROM FamilyMember;

deleteAllFamilyMembers:
DELETE FROM FamilyMember;

deleteDeletedDishComponentsPermanently:
DELETE FROM DishComponent WHERE dishId IN (SELECT id FROM Dish WHERE isDeleted = 1);

deleteDeletedDishesPermanently:
DELETE FROM Dish WHERE isDeleted = 1;

deleteDeletedBaseFoodsPermanently:
DELETE FROM BaseFood WHERE isDeleted = 1;
